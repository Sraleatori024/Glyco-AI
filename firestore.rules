rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nickinicolas380@gmail.com' ||
        request.auth.token.email == 'nickinicolas380@gmil.com'
      );
    }

    // Connection ping test
    match /test_connection/{docId} {
      allow read, write: if true;
    }

    // Users Collection (User Profiles & Settings)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
    }

    // Glucose records
    match /glucose_records/{recordId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Meal records
    match /meals/{mealId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Medication records
    match /medications/{medId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Insulin records
    match /insulin_records/{insulinId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Exercise history
    match /exercise_history/{exId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Copilot / Chat history
    match /ai_history/{msgId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
